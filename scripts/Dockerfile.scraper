FROM mcr.microsoft.com/playwright:v1.50.1-noble

WORKDIR /app

# Copiar package.json e instalar dependências
COPY package.json ./
RUN npm install --omit=dev playwright

# Copiar scripts
COPY scripts/scrape-leads.js ./scripts/
COPY scripts/scraper-server.js ./scripts/

# Variáveis de ambiente
ENV PORT=3001
