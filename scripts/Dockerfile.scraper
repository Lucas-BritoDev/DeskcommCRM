ENV ORG_ID=7e8ab2d5-4ebf-487b-a63c-3cfaf2311fb1
ENV CHANNEL_SESSION_ID=c9a44dd2-a0f9-4022-8001-7bacc947e025
ENV WHATSAPP_PHONE=5511926753226

EXPOSE 3001

CMD ["node", "scripts/scraper-server.js"]
